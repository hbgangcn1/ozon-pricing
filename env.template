# 微信支付配置示例
# 请复制此文件为 .env 并填写实际的配置信息
# 注意：.env 文件不会被提交到 Git

# ===========================================
# 数据库配置（新增）
# ===========================================

# 数据库类型：sqlite 或 postgresql
DB_TYPE=sqlite

# PostgreSQL配置（当DB_TYPE=postgresql时使用）
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=logistics
POSTGRES_USER=logistics_user
POSTGRES_PASSWORD=your_password_here

# SQLite配置（当DB_TYPE=sqlite时使用）
SQLITE_DB_PATH=logistics.db

# ===========================================
# 基础配置
# ===========================================

# 微信公众号或小程序 AppID
WECHAT_APP_ID=your_app_id_here

# 微信支付商户号
WECHAT_MCH_ID=your_merchant_id_here

# API v3 密钥（32位字符串）
WECHAT_API_V3_KEY=your_32_character_api_v3_key_here

# ===========================================
# 证书配置
# ===========================================

# 商户私钥文件路径（绝对路径或相对路径）
# 示例：/secure/path/apiclient_key.pem 或 cert/apiclient_key.pem
WECHAT_PRIVATE_KEY_PATH=cert/apiclient_key.pem

# 商户公钥文件路径（可选）
WECHAT_PUBLIC_KEY_PATH=cert/apiclient_cert.pem

# 商户证书序列号（可以包含冒号和空格，会自动清理格式）
WECHAT_CERT_SERIAL_NO=YOUR_CERT_SERIAL_NO_HERE

# ===========================================
# 回调配置
# ===========================================

# 支付结果通知地址（必须是 HTTPS）
WECHAT_NOTIFY_URL=https://your-domain.com/wechat/notify

# 支付完成跳转地址
WECHAT_RETURN_URL=https://your-domain.com/payment/success

# ===========================================
# 环境配置
# ===========================================

# 是否为生产环境（true/false）
PRODUCTION_MODE=false

# 是否使用沙箱环境（true/false）
WECHAT_SANDBOX=false

# 是否为本地测试模式（true/false）
LOCAL_TEST_MODE=false

# ===========================================
# 配置说明
# ===========================================
#
# 1. 获取 AppID：
#    - 登录微信公众平台 https://mp.weixin.qq.com
#    - 在【开发】->【基本配置】中查看
#
# 2. 获取商户号（mch_id）：
#    - 登录微信支付商户平台 https://pay.weixin.qq.com
#    - 在【账户中心】->【商户信息】中查看
#
# 3. 设置 API v3 密钥：
#    - 在微信支付商户平台【账户中心】->【API安全】
#    - 点击【设置API密钥】，生成32位密钥
#
# 4. 下载商户证书：
#    - 在【API安全】页面下载商户证书
#    - 解压后将 apiclient_key.pem 和 apiclient_cert.pem 放到 cert/ 目录
#    - 证书序列号在证书详情中可以查看
#
# 5. 安全提醒：
#    - 切勿将 .env 文件提交到 Git
#    - 生产环境证书应存放在安全目录，设置严格的文件权限
#    - 定期更换 API 密钥
#    - 使用环境变量或密钥管理服务存储敏感信息
#
# 6. 使用方法：
#    - 复制此文件：cp env.template .env
#    - 编辑 .env 文件，填写实际配置
#    - .env 文件会被自动忽略，不会提交到版本控制

# ===========================================
# 应用模式配置
# ===========================================

# 测试模式：true启用测试价格，false使用正式价格（默认：false）
TEST_MODE=false

# 公安备案模式：true启用备案模式，false正常登录流程（默认：false）
POLICE_FILING_MODE=false

