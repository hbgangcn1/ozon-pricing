# .env.example — copy to .env and fill in values
# Generate secrets with: python -c "import secrets; print(secrets.token_urlsafe(32))"

# === Database ===
DB_TYPE=postgresql
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=logistics
POSTGRES_USER=logistics_user
POSTGRES_PASSWORD=your_password_here
POSTGRES_OPTIONS=
SQLITE_DB_PATH=logistics.db
DB_POOL_SIZE=20
DB_POOL_MAX=50
DB_TIMEOUT=30

# === JWT / Auth ===
JWT_SECRET_KEY=your-secret-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=15
SESSION_SECRET=your-session-secret-here
SESSION_HMAC_SECRET=your-session-hmac-secret-here

# === Application ===
APP_ENV=development
PRODUCTION_MODE=false
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:5173
CSP_POLICY=
E2E_TEST=

# === WeChat Pay ===
WECHAT_APP_ID=your_app_id_here
WECHAT_MCH_ID=your_merchant_id_here
WECHAT_API_V3_KEY=your_32_character_api_v3_key_here
WECHAT_CERT_DIR=cert
WECHAT_PRIVATE_KEY_PATH=
WECHAT_PUBLIC_KEY_PATH=
WECHAT_CERT_SERIAL_NO=YOUR_CERT_SERIAL_NO_HERE
WECHAT_NOTIFY_URL=https://your-domain.com/wechat/notify
WECHAT_RETURN_URL=https://your-domain.com/payment/success
WECHAT_SANDBOX=false
WECHAT_PAY_DEBUG=false
LOCAL_TEST_MODE=false

# === Exchange Rate Providers ===
FIXER_IO_API_KEY=your_fixer_io_api_key_here
CURRENCY_LAYER_API_KEY=your_currency_layer_api_key_here

# === Security ===
ENCRYPTION_KEY=
ENCRYPTION_KEY_FILE=.encryption_key
MASTER_PASSWORD=
# [SEC-W12R2-05] Trust X-Forwarded-For only from these proxy CIDRs.
# Dev default trusts local reverse proxies only; production should set the nginx
# host/load balancer CIDRs explicitly.
TRUSTED_PROXY_IPS=127.0.0.1/32,::1/128
# Defaults to true when ENVIRONMENT is production/staging, false otherwise.
TRUST_FORWARDED_FOR=false

# === Application Mode ===
TEST_MODE=false
POLICE_FILING_MODE=false
