# 使用前请替换部署目录与运行用户（原作者实例：/var/www/ozon-pricing-private，用户 ozon）：
#   sed -i 's#/var/www/ozon-pricing-private#/srv/your-app#g; s/^User=ozon/User=www-data/; s/^Group=ozon/Group=www-data/' fastapi-app.service
# 数据库 unit 里写的是 postgresql@12-main.service，你的 PG 版本/实例名不同请一并改。

[Unit]
Description=CBPrice FastAPI Application (cbprice.cn)
After=network.target postgresql@12-main.service
Requires=postgresql@12-main.service

[Service]
Type=exec
User=ozon
Group=ozon
WorkingDirectory=/var/www/ozon-pricing-private
EnvironmentFile=/var/www/ozon-pricing-private/.env
Environment=PRODUCTION_MODE=true

# Gunicorn + Uvicorn workers
# 3 workers 适合 2 CPU / 3.6GB RAM 的服务器
# 绑定 127.0.0.1 — 仅通过 nginx 反向代理访问
ExecStart=/var/www/ozon-pricing-private/venv/bin/gunicorn api.main:app \
    -k uvicorn.workers.UvicornWorker \
    -w 3 \
    -b 127.0.0.1:8003 \
    --access-logfile /var/log/cbprice/access.log \
    --error-logfile /var/log/cbprice/error.log \
    --timeout 120 \
    --graceful-timeout 30 \
    --max-requests 1000 \
    --max-requests-jitter 50

# 自动重启策略
Restart=on-failure
RestartSec=5
StartLimitBurst=3
StartLimitIntervalSec=60

# 资源限制：生产机约 3.6GB RAM / 2 vCPU。
# MemoryMax=1500M 为 3 个 gunicorn worker 保留约 40% 内存，剩余约 60% 留给
# PostgreSQL、nginx 与系统页缓存；CPUQuota=180% 避免应用打满双核导致 SSH/nginx
# 无响应；TasksMax=512 足够 gunicorn worker、线程池与短生命周期子任务使用。
# 不配置 WatchdogSec：gunicorn/uvicorn worker 不发送 sd_notify watchdog 心跳。
MemoryMax=1500M
CPUQuota=180%
TasksMax=512

# 安全加固
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/ozon-pricing-private /var/log/cbprice
PrivateTmp=true

# 日志
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cbprice

[Install]
WantedBy=multi-user.target
