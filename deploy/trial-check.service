# 使用前请替换部署目录与运行用户（同 fastapi-app.service）：
#   sed -i 's#/var/www/ozon-pricing-private#/srv/your-app#g; s/^User=ozon/User=www-data/; s/^Group=ozon/Group=www-data/' trial-check.service

[Unit]
Description=CBPrice trial expiry + overflow window scheduler (one-shot)
After=network.target postgresql@12-main.service
Requires=postgresql@12-main.service

[Service]
Type=oneshot
User=ozon
Group=ozon
WorkingDirectory=/var/www/ozon-pricing-private
EnvironmentFile=/var/www/ozon-pricing-private/.env
Environment=PRODUCTION_MODE=true
ExecStart=/var/www/ozon-pricing-private/venv/bin/python -m scripts.trial_check --once

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/ozon-pricing-private /var/log/cbprice
PrivateTmp=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=cbprice-trial-check
