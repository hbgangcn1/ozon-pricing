[Unit]
Description=CBPrice trial expiry + overflow window scheduler (one-shot)
After=network.target postgresql@12-main.service
Requires=postgresql@12-main.service

[Service]
Type=oneshot
User=SSH_USER
Group=SSH_USER
WorkingDirectory=/var/www/ozon-pricing
EnvironmentFile=/var/www/ozon-pricing/.env
Environment=PRODUCTION_MODE=true
ExecStart=/var/www/ozon-pricing/venv/bin/python -m scripts.trial_check --once

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/ozon-pricing /var/log/cbprice
PrivateTmp=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=cbprice-trial-check
